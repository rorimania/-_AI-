---
import { gallerySlides } from '../data/gallery';

const count = String(gallerySlides.length).padStart(2, '0');
const half = Math.floor(gallerySlides.length / 2);
const initialOffset = (index: number) =>
  index <= half ? index : index - gallerySlides.length;
---

<section class="gallery-section" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div
      class="gallery-carousel"
      data-gallery
      role="region"
      aria-roledescription="carousel"
      aria-label="器影长廊"
      tabindex="0"
    >
      <div class="gallery-controls">
        <button class="gallery-control" type="button" data-gallery-prev aria-label="上一件器物">
          <span aria-hidden="true">←</span>
        </button>
        <p class="gallery-status" aria-live="polite">
          <span class="latin" data-gallery-current>01</span>
          <span class="gallery-status__rule" aria-hidden="true"></span>
          <span class="latin">{count}</span>
          <span class="gallery-status__name" data-gallery-name>梅瓶</span>
        </p>
        <button class="gallery-control" type="button" data-gallery-next aria-label="下一件器物">
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <div class="gallery-dots" aria-label="选择器物">
        {gallerySlides.map((slide, index) => (
          <button
            class:list={['gallery-dot', { 'is-active': index === 0 }]}
            type="button"
            aria-label={`查看${slide.title}`}
            aria-current={index === 0 ? 'true' : 'false'}
            data-gallery-dot={index}
          ></button>
        ))}
      </div>

      <div class="gallery-carousel__stage" data-gallery-stage>
        <span class="gallery-carousel__axis" aria-hidden="true"></span>
        <span class="gallery-carousel__axis gallery-carousel__axis--soft" aria-hidden="true"></span>

        {gallerySlides.map((slide, index) => (
          <button
            class:list={['gallery-card', { 'is-active': index === 0 }]}
            type="button"
            data-gallery-card
            data-gallery-index={index}
            aria-label={`预览${slide.title}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            tabindex={index === 0 ? 0 : -1}
            data-preview={slide.preview ?? slide.image ?? ''}
            data-title={slide.title}
            data-en={slide.en}
            data-era={slide.era}
            data-note={slide.note}
            style={`--offset: ${initialOffset(index)}; --abs: ${Math.abs(initialOffset(index))}; --tone: ${slide.tone}; --tone-soft: ${slide.toneSoft};`}
          >
            <span class="gallery-card__frame">
              {slide.image ? (
                <img
                  class="gallery-card__image"
                  src={slide.image}
                  alt={slide.alt ?? `${slide.title}的器影`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <span class="gallery-card__placeholder" aria-hidden="true">
                  <span class="gallery-card__await">影像待入 · PLACEHOLDER</span>
                  <span class="gallery-card__glyph">{slide.glyph}</span>
                  <span class="gallery-card__halo"></span>
                  <span class="gallery-card__index">{String(index + 1).padStart(2, '0')}</span>
                </span>
              )}
              <span class="gallery-card__edge" aria-hidden="true"></span>
            </span>
            <span class="gallery-card__caption">
              <span class="gallery-card__row">
                <span class="gallery-card__title">{slide.title}</span>
                <span class="gallery-card__en">{slide.en}</span>
              </span>
              <span class="gallery-card__era">{slide.era}</span>
              <span class="gallery-card__note">{slide.note}</span>
            </span>
          </button>
        ))}
      </div>


      <p class="gallery-hint">鼠标悬停器影 · 滚轮换一只 · 点击卡片预览</p>
    </div>

    <header class="gallery-head">
      <div>
        <p class="eyebrow reveal">数字陶艺 · 器影长廊</p>
        <h2 class="h2 reveal" id="gallery-title" style="--delay: 80ms">把器物的侧面，<br />交给光。</h2>
        <p class="gallery-head__lead reveal" style="--delay: 120ms">
          先见器影，再亲手做一只。一组器物影像在一条会转动的长廊里依次经过。
        </p>
      </div>
      <div class="gallery-head__aside">
        <p class="gallery-head__note reveal" style="--delay: 140ms">
          把鼠标移到器影上，使用滚轮换一只；点击卡片可放大预览。
        </p>
        <div class="gallery-head__actions reveal" style="--delay: 180ms">
          <a class="btn btn--solid" href="/create/clay">
            开始制器 <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/#process">先看五道工序 <span class="arrow" aria-hidden="true">↓</span></a>
        </div>
      </div>
    </header>
  </div>

  <dialog class="gallery-preview" data-gallery-preview aria-label="器影预览">
    <div class="gallery-preview__inner">
      <button class="gallery-preview__close" type="button" aria-label="关闭预览" data-gallery-preview-close>
        <span aria-hidden="true">×</span>
      </button>
      <figure class="gallery-preview__figure">
        <img class="gallery-preview__image" data-gallery-preview-image alt="" />
        <figcaption class="gallery-preview__caption">
          <span class="gallery-preview__index latin" data-gallery-preview-index></span>
          <span class="gallery-preview__title" data-gallery-preview-title></span>
          <span class="gallery-preview__en" data-gallery-preview-en></span>
          <span class="gallery-preview__era" data-gallery-preview-era></span>
          <p class="gallery-preview__note" data-gallery-preview-note></p>
        </figcaption>
      </figure>
    </div>
  </dialog>
</section>

<style>
  .gallery-section {
    padding-block: clamp(18px, 2.6vh, 32px) var(--section-y);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background:
      radial-gradient(ellipse at 50% 42%, rgba(233, 225, 211, 0.42), transparent 60%),
      var(--surface);
  }

  .gallery-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.62fr);
    align-items: end;
    gap: clamp(28px, 5vw, 90px);
    margin-top: clamp(30px, 4.5vh, 52px);
    padding-top: clamp(24px, 4vh, 42px);
    border-top: 1px solid var(--hairline);
  }

  .gallery-head .h2 {
    margin-top: 18px;
  }

  .gallery-head__lead {
    max-width: 30ch;
    margin-top: 18px;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.9;
  }

  .gallery-head__aside {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .gallery-head__note {
    max-width: 34ch;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .gallery-head__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .gallery-carousel {
    position: relative;
    outline: none;
  }

  .gallery-carousel:focus-visible {
    outline: 1px solid var(--text);
    outline-offset: 8px;
  }

  .gallery-carousel__stage {
    position: relative;
    margin-top: 8px;
    height: clamp(500px, 54vw, 720px);
    perspective: 1600px;
    perspective-origin: 50% 38%;
    transform-style: preserve-3d;
    touch-action: pan-y;
    cursor: default;
    user-select: none;
  }

  .gallery-carousel__axis {
    position: absolute;
    top: 8%;
    bottom: 6%;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--hairline-soft) 18%, var(--hairline-soft) 82%, transparent);
    pointer-events: none;
  }

  .gallery-carousel__axis--soft {
    left: 50%;
    transform: translateX(-50%) scaleY(0.9);
    width: 1px;
    opacity: 0.5;
    background: repeating-linear-gradient(180deg, var(--hairline) 0 3px, transparent 3px 8px);
  }

  .gallery-card {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: calc(10 - var(--abs, 0));
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: clamp(230px, 26vw, 360px);
    padding: 0;
    border: 0;
    text-align: left;
    background: none;
    color: var(--text);
    opacity: calc(1 - var(--abs, 0) * 0.19);
    transform:
      translate(-50%, -50%)
      translateX(calc(var(--offset, 0) * 64%))
      translateZ(calc(var(--abs, 0) * -120px))
      rotateY(calc(var(--offset, 0) * -28deg))
      scale(calc(1 - var(--abs, 0) * 0.085));
    transform-style: preserve-3d;
    transition:
      transform 0.9s var(--ease),
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease);
    cursor: pointer;
  }

  .gallery-card:not(.is-active) {
    filter: blur(0.2px);
  }

  .gallery-card.is-active {
    z-index: 10;
    opacity: 1;
    cursor: default;
  }

  .gallery-card__frame {
    position: relative;
    display: block;
    aspect-ratio: 0.72;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: linear-gradient(150deg, #faf6ee, #e6dbc9);
    box-shadow: 0 26px 54px rgba(59, 43, 28, 0.12);
    transition: border-color var(--dur-2) var(--ease);
  }

  .gallery-card.is-active .gallery-card__frame {
    border-color: color-mix(in srgb, var(--text) 38%, transparent);
    box-shadow: 0 34px 64px rgba(59, 43, 28, 0.17);
  }

  .gallery-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 32%, color-mix(in srgb, var(--tone) 55%, #fff) 0%, var(--tone) 58%, color-mix(in srgb, var(--tone) 72%, #2d261f) 100%);
  }

  .gallery-card__placeholder::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px dashed rgba(255, 250, 240, 0.2);
    pointer-events: none;
  }

  .gallery-card__placeholder::before {
    content: '';
    position: absolute;
    top: 16%;
    bottom: 14%;
    left: 50%;
    width: 58%;
    transform: translateX(-50%);
    border: 1px solid rgba(255, 250, 240, 0.24);
    border-radius: 48% 48% 42% 42% / 32% 32% 20% 20%;
    opacity: 0.65;
  }

  .gallery-card__await {
    position: absolute;
    top: 22px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-latin);
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    white-space: nowrap;
    color: rgba(255, 250, 240, 0.62);
  }

  .gallery-card__glyph {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: clamp(5.5rem, 10vw, 8rem);
    font-weight: 400;
    line-height: 1;
    color: rgba(255, 250, 240, 0.86);
    opacity: 0.9;
    text-shadow: 0 16px 40px rgba(50, 32, 16, 0.2);
    transition: transform var(--dur-3) var(--ease);
  }

  .gallery-card.is-active .gallery-card__glyph {
    transform: translateY(-4px);
  }

  .gallery-card__halo {
    position: absolute;
    bottom: 16%;
    left: 50%;
    width: 60%;
    height: 16%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(61, 45, 30, 0.18), transparent 70%);
    filter: blur(9px);
  }

  .gallery-card__index {
    position: absolute;
    right: 20px;
    bottom: 15px;
    z-index: 1;
    font-family: var(--font-latin);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: rgba(255, 250, 240, 0.7);
  }

  .gallery-card__edge {
    position: absolute;
    inset: 9px;
    border: 1px solid rgba(250, 246, 238, 0.26);
    pointer-events: none;
  }

  .gallery-card__caption {
    display: grid;
    gap: 1px;
    padding-left: 2px;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease);
  }

  .gallery-card.is-active .gallery-card__caption {
    opacity: 1;
  }

  .gallery-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .gallery-card__title {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    letter-spacing: 0.08em;
  }

  .gallery-card__en {
    font-family: var(--font-latin);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    color: var(--text-faint);
  }

  .gallery-card__era {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .gallery-card__note {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    margin-top: 4px;
    font-size: 0.68rem;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .gallery-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 22px;
  }

  .gallery-control {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--hairline);
    font-family: var(--font-latin);
    font-size: 0.9rem;
    color: var(--text-soft);
    transition:
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease);
  }

  .gallery-control:hover,
  .gallery-control:focus-visible {
    border-color: var(--text);
    background: var(--accent-soft);
    color: var(--text);
  }

  .gallery-status {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 130px;
    justify-content: center;
    font-family: var(--font-latin);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  .gallery-status__rule {
    width: 24px;
    height: 1px;
    background: var(--hairline);
  }

  .gallery-status__name {
    margin-left: 8px;
    font-family: var(--font-serif);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    color: var(--text-soft);
  }

  .gallery-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-top: 10px;
  }

  .gallery-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hairline);
    transition:
      width var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease);
  }

  .gallery-dot.is-active {
    width: 17px;
    border-radius: 999px;
    background: var(--celadon-deep);
  }

  .gallery-hint {
    margin-top: 14px;
    text-align: center;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--text-faint);
  }

  .gallery-card__image {
    object-position: center 38%;
  }

  .gallery-card__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(20, 18, 16, 0.08), transparent 22%, transparent 78%, rgba(20, 18, 16, 0.12));
  }

  /* Image viewer */
  .gallery-preview {
    width: min(1180px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: var(--text);
  }

  .gallery-preview::backdrop {
    background: rgba(18, 16, 13, 0.76);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  :global(body:has(.gallery-preview[open])) {
    overflow: hidden;
  }

  .gallery-preview__inner {
    position: relative;
    overflow: auto;
    max-height: calc(100svh - 32px);
    background: var(--paper-light);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.3);
  }

  .gallery-preview__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--paper-light) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-family: var(--font-latin);
    font-size: 1.15rem;
    line-height: 1;
    color: var(--text-soft);
    transition:
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  .gallery-preview__close:hover,
  .gallery-preview__close:focus-visible {
    border-color: var(--text);
    color: var(--text);
  }

  .gallery-preview__figure {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.45fr);
    margin: 0;
    min-height: min(70svh, 760px);
  }

  .gallery-preview__image {
    width: 100%;
    height: 100%;
    max-height: calc(100svh - 32px);
    object-fit: contain;
    background: #141210;
  }

  .gallery-preview__caption {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 5px;
    padding: clamp(24px, 3.6vw, 48px);
    border-left: 1px solid var(--hairline);
    background:
      linear-gradient(180deg, transparent 0 58%, rgba(184, 97, 58, 0.035) 58% 58.2%, transparent 58.2%),
      var(--paper-light);
  }

  .gallery-preview__index {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--kiln);
  }

  .gallery-preview__title {
    margin-top: 18px;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 2.8vw, 2.7rem);
    line-height: 1.25;
    letter-spacing: 0.05em;
  }

  .gallery-preview__en {
    font-family: var(--font-latin);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .gallery-preview__era {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--text-soft);
  }

  .gallery-preview__note {
    max-width: 28ch;
    margin-top: 7px;
    font-size: 0.86rem;
    line-height: 1.9;
    color: var(--text-soft);
  }

  .gallery-preview[open] .gallery-preview__inner {
    animation: gallery-preview-in 0.5s var(--ease) both;
  }

  @keyframes gallery-preview-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 1000px) {
    .gallery-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .gallery-carousel__stage {
      height: clamp(470px, 60vw, 620px);
    }

    .gallery-card {
      width: clamp(220px, 30vw, 310px);
    }
  }

  @media (max-width: 760px) {
    .gallery-preview {
      width: calc(100vw - 20px);
      max-height: calc(100svh - 20px);
    }

    .gallery-preview__inner {
      max-height: calc(100svh - 20px);
    }

    .gallery-preview__figure {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .gallery-preview__image {
      max-height: 56svh;
      object-fit: contain;
    }

    .gallery-preview__caption {
      min-height: 0;
      padding: 22px 20px 26px;
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }

    .gallery-preview__title {
      margin-top: 10px;
      font-size: 1.75rem;
    }

    .gallery-preview__era {
      margin-top: 12px;
      padding-top: 10px;
    }

    .gallery-preview__close {
      top: 10px;
      right: 10px;
      width: 34px;
      height: 34px;
    }
  }

  @media (max-width: 620px) {
    .gallery-carousel__stage {
      height: 480px;
    }

    .gallery-card {
      width: min(68vw, 270px);
    }

    .gallery-card__caption {
      gap: 0;
    }

    .gallery-card__note {
      display: none;
    }

    .gallery-card__glyph {
      font-size: 6rem;
    }

    .gallery-status {
      min-width: 110px;
    }

    .gallery-hint {
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card,
    .gallery-card__glyph,
    .gallery-card__caption {
      transition: none;
    }

    .gallery-preview[open] .gallery-preview__inner {
      animation: none;
    }
  }
</style>
