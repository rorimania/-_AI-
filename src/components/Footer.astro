---
import { steps } from '../data/site';
---

<footer class="site-footer" id="about">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <span class="seal" aria-hidden="true">瓷</span>
        <p class="site-footer__word">瓷韵数绎</p>
        <p class="site-footer__line">把一抔土，交给时间与火。</p>
        <p class="micro" style="color: var(--night-faint)">AI 赋能的陶瓷文化数字化传播与互动体验平台</p>
      </div>

      <div class="site-footer__cols">
        <div class="site-footer__col">
          <p class="micro">行旅</p>
          <a href="/">识器</a>
          <a href="/#process">工序</a>
          <a href="/ciku">瓷库</a>
          <a href="/#gallery">器影</a>
          <a href="/#observe">观器</a>
        </div>
        <div class="site-footer__col">
          <p class="micro">制器</p>
          {steps.map((step) => <a href={step.href}>{step.name}</a>)}
        </div>
        <div class="site-footer__col">
          <p class="micro">素材</p>
          <a href="/credits">素材与鸣谢</a>
          <a href="https://www.metmuseum.org/art/collection" target="_blank" rel="noopener noreferrer">The Met · CC0</a>
          <a href="https://polyhaven.com/a/studio_small_03" target="_blank" rel="noopener noreferrer">Poly Haven · CC0</a>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>第九届传智杯 · 瓷韵数绎</span>
      <span>数字陶艺交互体验 · 五道工序</span>
      <span>馆藏图像仅作文化参照，版权归原机构所有</span>
      <span class="latin">© 2026</span>
    </div>
  </div>
  <div class="site-footer__watermark" aria-hidden="true">瓷</div>
</footer>
