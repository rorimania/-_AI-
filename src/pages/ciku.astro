---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cikuCategories } from '../data/ciku';

const chapters = cikuCategories.map((category) => ({
  ...category,
  imageCount: category.items.reduce((total, item) => total + item.images.length, 0),
}));
const categoryCount = chapters.length;
const itemCount = chapters.reduce((total, category) => total + category.items.length, 0);
const imageCount = chapters.reduce((total, category) => total + category.imageCount, 0);

const heroCategory = chapters.find((category) => category.id === 'coloured-glaze') ?? chapters[0];
const heroItem =
  heroCategory.items.find((item) => item.dpmId === '227434') ??
  heroCategory.items.find((item) => item.images.length > 0) ??
  heroCategory.items[0];
const heroImage = heroItem.images[0];
const heroTitle = heroItem.title.replace(/（其[一二三四五六七八九十]+）$/, '');
const cikuJson = JSON.stringify(cikuCategories).replace(/</g, '\\u003c');
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout
  title="瓷库 · 十类器物"
  description={`瓷库收录十类 ${itemCount} 件陶瓷器物：红陶、灰陶、白陶、黑陶、彩陶、彩绘陶、釉陶、原始瓷、釉下彩与颜色釉。图像与文字资料来自故宫博物院数字文物库。`}
  page="ciku"
>
  <section class="ciku-hero" aria-labelledby="ciku-title">
    <div class="container">
      <div class="ciku-hero__top">
        <div class="ciku-hero__copy">
          <p class="eyebrow reveal">瓷库 · Vessel Archive</p>
          <div class="ciku-hero__title-row reveal" style="--delay: 60ms">
            <h1 class="ciku-hero__title" id="ciku-title">瓷库</h1>
            <span class="seal ciku-hero__seal" aria-hidden="true">库</span>
          </div>
          <p class="ciku-hero__lead reveal" style="--delay: 140ms">
            从新石器时代的红陶，到隋代的白釉。十类器物，{itemCount} 件藏品，一条从土到瓷的路。
          </p>
          <dl class="ciku-hero__stats reveal" style="--delay: 200ms" aria-label="瓷库收录概要">
            <div class="ciku-hero__stat">
              <dd class="ciku-hero__stat-num latin">{categoryCount}</dd>
              <dt class="ciku-hero__stat-label micro">器类</dt>
            </div>
            <div class="ciku-hero__stat">
              <dd class="ciku-hero__stat-num latin">{itemCount}</dd>
              <dt class="ciku-hero__stat-label micro">藏品</dt>
            </div>
            <div class="ciku-hero__stat">
              <dd class="ciku-hero__stat-num latin">{imageCount}</dd>
              <dt class="ciku-hero__stat-label micro">影像</dt>
            </div>
          </dl>
        </div>

        <figure class="ciku-hero__plate reveal" style="--delay: 180ms">
          <div class="ciku-hero__plate-frame">
            {heroImage ? (
              <img
                src={heroImage.src}
                alt={heroImage.alt}
                width="1024"
                height="1280"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            ) : (
              <span class="ciku-hero__plate-empty" aria-hidden="true">瓷</span>
            )}
            <span class="ciku-hero__plate-no latin" aria-hidden="true">NO. {heroItem.dpmId}</span>
          </div>
          <figcaption class="ciku-hero__plate-caption">
            <span class="ciku-hero__plate-name">{heroTitle}</span>
            <span class="ciku-hero__plate-meta">{heroItem.dynasty} · 故宫博物院</span>
          </figcaption>
        </figure>
      </div>

      <div class="ciku-index reveal">
        <div class="ciku-index__head">
          <p class="micro">总目 · Index</p>
          <p class="ciku-index__note">十类 · 按胎与釉的先后排列</p>
        </div>
        <ol class="ciku-index__list">
          {chapters.map((category) => (
            <li class="ciku-index__item">
              <a class="ciku-index__link" href={`#${category.id}`}>
                <span class="ciku-index__num latin" aria-hidden="true">{category.num}</span>
                <span class="ciku-index__name">{category.name}</span>
                <span class="ciku-index__en">{category.en}</span>
                <span class="ciku-index__count latin">{pad(category.items.length)}</span>
                <span class="ciku-index__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <nav class="ciku-rail" aria-label="瓷库分类导航" data-ciku-rail>
    <div class="container ciku-rail__inner">
      <span class="micro ciku-rail__label">分类</span>
      <ol class="ciku-rail__list" data-ciku-rail-list>
        {chapters.map((category) => (
          <li>
            <a
              class="ciku-rail__link"
              href={`#${category.id}`}
              data-ciku-rail-link={category.id}
            >
              <span class="latin" aria-hidden="true">{category.num}</span>
              {category.name}
            </a>
          </li>
        ))}
      </ol>
      <span class="ciku-rail__status" aria-hidden="true">
        <span data-ciku-rail-current>01</span><span class="ciku-rail__status-sep">/</span>{pad(chapters.length)}
      </span>
    </div>
  </nav>

  <div class="container ciku-body">
    {chapters.map((category) => (
      <section
        class="ciku-chapter"
        id={category.id}
        data-ciku-chapter={category.id}
        aria-labelledby={`${category.id}-title`}
      >
        <header class="ciku-chapter__head">
          <p class="ciku-chapter__num latin" aria-hidden="true">{category.num}</p>
          <div class="ciku-chapter__titles">
            <h2 class="ciku-chapter__name" id={`${category.id}-title`}>{category.name}</h2>
            <p class="ciku-chapter__en micro">{category.en}</p>
          </div>
          <p class="ciku-chapter__intro">{category.intro}</p>
          <div class="ciku-chapter__meta">
            <span>{category.period}</span>
            <span class="ciku-chapter__count">{category.items.length} 件 · {category.imageCount} 影</span>
          </div>
        </header>

        <ol class="ciku-grid">
          {category.items.map((item, index) => {
            const cover = item.images[0];
            return (
              <li class="ciku-cell">
                <a
                  class="ciku-card"
                  href={item.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-ciku-open={item.id}
                  aria-haspopup="dialog"
                >
                  <span class="ciku-card__frame">
                    {cover ? (
                      <img src={cover.card} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="ciku-card__empty">
                        <span class="ciku-card__empty-glyph" aria-hidden="true">瓷</span>
                        <span class="ciku-card__empty-label">暂无图像</span>
                      </span>
                    )}
                    <span class="ciku-card__no latin" aria-hidden="true">
                      {pad(index + 1)}
                    </span>
                    <span class="ciku-card__cue" aria-hidden="true">
                      观其详 <span>↗</span>
                    </span>
                  </span>
                  <span class="ciku-card__meta">
                    <span class="ciku-card__title">{item.title}</span>
                    <span class="ciku-card__era">
                      {[item.dynasty, item.culture].filter(Boolean).join(' · ') || item.era}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <p class="ciku-source">
      图像与文字资料来自
      <a href="https://www.dpm.org.cn/" target="_blank" rel="noopener noreferrer">故宫博物院数字文物库</a>，
      仅用于本次赛事的陶瓷文化展示，版权归故宫博物院所有。
    </p>
  </div>

  <dialog class="ciku-dialog" data-ciku-dialog aria-labelledby="ciku-dialog-title">
    <div class="ciku-dialog__shell">
      <button class="ciku-dialog__close" type="button" aria-label="关闭详情" data-ciku-close>
        <span aria-hidden="true">×</span>
      </button>

      <div class="ciku-dialog__media">
        <figure class="ciku-dialog__figure" data-ciku-dialog-figure>
          <img class="ciku-dialog__image" data-ciku-dialog-image alt="" />
          <span class="ciku-dialog__empty" data-ciku-dialog-empty hidden aria-hidden="true">
            <span class="ciku-dialog__empty-glyph">瓷</span>
            <span class="micro">图像待补 · No image</span>
          </span>
        </figure>
        <div class="ciku-dialog__thumbs" data-ciku-dialog-thumbs aria-label="器物图像"></div>
        <p class="ciku-dialog__hint micro" data-ciku-dialog-hint></p>
      </div>

      <div class="ciku-dialog__info">
        <p class="ciku-dialog__eyebrow micro" data-ciku-dialog-cat></p>
        <h2 class="ciku-dialog__title" id="ciku-dialog-title" data-ciku-dialog-title aria-live="polite"></h2>
        <p class="ciku-dialog__era" data-ciku-dialog-era></p>

        <dl class="ciku-dialog__facts">
          <div>
            <dt>年代</dt>
            <dd data-ciku-dialog-age></dd>
          </div>
          <div>
            <dt>尺寸</dt>
            <dd data-ciku-dialog-dims></dd>
          </div>
          <div>
            <dt>馆藏编号</dt>
            <dd class="latin" data-ciku-dialog-id></dd>
          </div>
        </dl>

        <div class="ciku-dialog__scroll">
          <p class="ciku-dialog__desc" data-ciku-dialog-desc></p>
          <p class="ciku-dialog__rights micro">图像版权归故宫博物院所有 · 仅作文化展示</p>
        </div>

        <div class="ciku-dialog__foot">
          <a
            class="ciku-dialog__source"
            data-ciku-dialog-source
            href="https://www.dpm.org.cn/"
            target="_blank"
            rel="noopener noreferrer"
          >
            故宫博物院数字文物库 <span aria-hidden="true">↗</span>
          </a>
          <div class="ciku-dialog__nav">
            <button type="button" data-ciku-prev aria-label="上一件器物"><span aria-hidden="true">←</span></button>
            <span class="latin ciku-dialog__position" data-ciku-position></span>
            <button type="button" data-ciku-next aria-label="下一件器物"><span aria-hidden="true">→</span></button>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <script type="application/json" data-ciku-data set:html={cikuJson} is:inline></script>
</BaseLayout>

<script>
  import '../scripts/ciku';
</script>

<style>
  /* ------------------------------------------------------------------
     Hero
  ------------------------------------------------------------------- */
  .ciku-hero {
    position: relative;
    padding-block: clamp(40px, 6.4vh, 76px) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .ciku-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.52fr);
    align-items: center;
    gap: clamp(38px, 7vw, 110px);
  }

  .ciku-hero__copy {
    min-width: 0;
  }

  .ciku-hero__title-row {
    display: flex;
    align-items: flex-end;
    gap: clamp(14px, 2vw, 26px);
    margin-top: 18px;
  }

  .ciku-hero__title {
    margin-left: -0.06em;
    font-family: var(--font-serif);
    font-size: clamp(4.8rem, 10.6vw, 9.6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .ciku-hero__seal {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
    margin-bottom: clamp(8px, 1.2vw, 18px);
    font-size: 1.02rem;
    transform: rotate(2deg);
    opacity: 0.9;
  }

  .ciku-hero__lead {
    max-width: 34ch;
    margin-top: clamp(22px, 3.4vh, 34px);
    font-size: var(--text-lead);
    line-height: 1.95;
    color: var(--text-soft);
  }

  .ciku-hero__stats {
    display: flex;
    align-items: stretch;
    max-width: 430px;
    margin-top: clamp(30px, 5vh, 52px);
    border-top: 1px solid var(--hairline);
    padding-top: 16px;
  }

  .ciku-hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    min-width: 0;
    padding-right: clamp(20px, 3vw, 40px);
  }

  .ciku-hero__stat + .ciku-hero__stat {
    padding-left: clamp(20px, 3vw, 40px);
    border-left: 1px solid var(--hairline-soft);
  }

  .ciku-hero__stat:last-child {
    padding-right: 0;
  }

  .ciku-hero__stat-num {
    font-size: clamp(1.7rem, 2.4vw, 2.3rem);
    line-height: 1;
    color: var(--text);
  }

  .ciku-hero__stat-label {
    color: var(--text-faint);
    letter-spacing: 0.2em;
  }

  .ciku-hero__plate {
    justify-self: end;
    width: 100%;
    max-width: 400px;
    margin: 0;
  }

  .ciku-hero__plate-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    padding: clamp(8px, 0.9vw, 12px);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--surface-raised);
    box-shadow: 0 26px 56px rgba(52, 37, 23, 0.13);
  }

  .ciku-hero__plate-frame::after {
    content: '';
    position: absolute;
    inset: clamp(8px, 0.9vw, 12px);
    border: 1px solid rgba(250, 246, 238, 0.24);
    pointer-events: none;
  }

  .ciku-hero__plate-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    filter: saturate(0.96);
  }

  .ciku-hero__plate-no {
    position: absolute;
    top: calc(clamp(8px, 0.9vw, 12px) + 12px);
    left: calc(clamp(8px, 0.9vw, 12px) + 12px);
    z-index: 1;
    padding: 5px 8px;
    background: color-mix(in srgb, var(--paper-light) 88%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-soft);
  }

  .ciku-hero__plate-empty {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-serif);
    font-size: 5rem;
    color: var(--text-faint);
    opacity: 0.4;
  }

  .ciku-hero__plate-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline-soft);
    margin-top: 12px;
  }

  .ciku-hero__plate-name {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  .ciku-hero__plate-meta {
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* ------------------------------------------------------------------
     Index
  ------------------------------------------------------------------- */
  .ciku-index {
    margin-top: clamp(46px, 7.4vh, 82px);
    padding-top: clamp(20px, 3vh, 28px);
    padding-bottom: clamp(38px, 6vh, 60px);
    border-top: 1px solid var(--hairline);
  }

  .ciku-index__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }

  .ciku-index__note {
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .ciku-index__list {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(5, auto);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(30px, 5.4vw, 84px);
  }

  .ciku-index__link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto auto auto;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline-soft);
    transition:
      background-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .ciku-index__link::before {
    content: '';
    position: absolute;
    inset: 0 -10px;
    z-index: -1;
    background: var(--accent-soft);
    opacity: 0;
    transform: scaleX(0.96);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
  }

  .ciku-index__link:hover::before,
  .ciku-index__link:focus-visible::before {
    opacity: 0.55;
    transform: scaleX(1);
  }

  .ciku-index__num {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .ciku-index__name {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    letter-spacing: 0.08em;
    transition: transform var(--dur-2) var(--ease);
  }

  .ciku-index__link:hover .ciku-index__name {
    transform: translateX(3px);
  }

  .ciku-index__en {
    justify-self: end;
    font-family: var(--font-latin);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-faint);
  }

  .ciku-index__count {
    min-width: 2ch;
    text-align: right;
    font-size: 0.6rem;
    color: var(--text-faint);
    opacity: 0.75;
  }

  .ciku-index__arrow {
    display: inline-block;
    font-family: var(--font-latin);
    font-size: 0.82rem;
    color: var(--celadon-deep);
    opacity: 0;
    transform: translateX(-5px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease);
  }

  .ciku-index__link:hover .ciku-index__arrow,
  .ciku-index__link:focus-visible .ciku-index__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ------------------------------------------------------------------
     Category rail
  ------------------------------------------------------------------- */
  .ciku-rail {
    position: sticky;
    top: var(--nav-h);
    z-index: var(--z-rail);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.06);
    backdrop-filter: blur(16px) saturate(1.06);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .ciku-rail__inner {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    min-height: 54px;
  }

  .ciku-rail__label {
    flex: 0 0 auto;
    color: var(--text-faint);
    letter-spacing: 0.2em;
  }

  .ciku-rail__list {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ciku-rail__list::-webkit-scrollbar {
    display: none;
  }

  .ciku-rail__link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 10px clamp(9px, 1.1vw, 14px);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--text-faint);
    transition: color var(--dur-1) var(--ease);
  }

  .ciku-rail__link .latin {
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    opacity: 0.66;
  }

  .ciku-rail__link::after {
    content: '';
    position: absolute;
    right: clamp(9px, 1.1vw, 14px);
    bottom: 3px;
    left: clamp(9px, 1.1vw, 14px);
    height: 1px;
    background: var(--celadon-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2) var(--ease);
  }

  .ciku-rail__link:hover {
    color: var(--text-soft);
  }

  .ciku-rail__link.is-active {
    color: var(--text);
  }

  .ciku-rail__link.is-active .latin {
    color: var(--celadon-deep);
    opacity: 1;
  }

  .ciku-rail__link.is-active::after {
    transform: scaleX(1);
  }

  .ciku-rail__status {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    font-family: var(--font-latin);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .ciku-rail__status-sep {
    margin-inline: 3px;
    opacity: 0.55;
  }

  /* ------------------------------------------------------------------
     Chapters
  ------------------------------------------------------------------- */
  .ciku-body {
    padding-bottom: clamp(64px, 10vh, 120px);
  }

  .ciku-chapter {
    display: grid;
    grid-template-columns: minmax(196px, 0.29fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(30px, 4.6vw, 68px);
    padding-block: clamp(48px, 7vh, 82px);
    border-top: 1px solid var(--hairline);
    scroll-margin-top: calc(var(--nav-h) + 55px);
  }

  .ciku-chapter:first-child {
    border-top: 0;
    padding-top: clamp(36px, 5.4vh, 60px);
  }

  .ciku-chapter__head {
    position: sticky;
    top: calc(var(--nav-h) + 55px + 28px);
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .ciku-chapter__num {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--celadon-deep);
  }

  .ciku-chapter__num::after {
    content: '';
    width: 30px;
    height: 1px;
    background: currentColor;
    opacity: 0.42;
  }

  .ciku-chapter__titles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-top: 12px;
  }

  .ciku-chapter__name {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 2.7vw, 2.65rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }

  .ciku-chapter__en {
    color: var(--text-faint);
    letter-spacing: 0.14em;
    font-size: 0.58rem;
  }

