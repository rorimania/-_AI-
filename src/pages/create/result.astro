---
import CreateLayout from '../../layouts/CreateLayout.astro';
import VesselPoster from '../../components/VesselPoster.astro';
import { defaultCraft } from '../../data/crafts';
import { steps } from '../../data/site';
import { JOURNEY_STAGES } from '../../lib/journey';

const now = new Date();
const dateLabel = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;
---

<CreateLayout
  step={5}
  page="result"
  title="开窑 · 成品"
  description="第五道工序：窑门打开，器物落定。查看你的器物档案，保存或分享这只由你完成的瓷器。"
  showFooter={true}
>
  <div class="result-page">
    <header class="result-head">
      <p class="eyebrow">第五道 · 开窑 <span class="latin">/ Reveal</span></p>
      <div class="result-head__row">
        <h1 class="result-head__title">器成，<br />见你。</h1>
        <p class="result-head__note">
          窑门打开，釉色落定。这只器物由你的轮廓、所选的釉色与这一窑的火共同完成。
        </p>
      </div>
    </header>

    <div class="result-main">
      <section class="result-stage" data-result-stage aria-label="成品陈列">
        <span class="result-stage__tag micro">开窑 · 成品</span>
        <div class="result-stage__arch" aria-hidden="true"></div>
        <div class="result-stage__vessel">
          <VesselPoster tone={defaultCraft.tone} label="你完成的青花瓷瓶" />
          <div class="result-canvas" data-result-canvas aria-hidden="true"></div>
        </div>
        <div class="result-stage__plinth" aria-hidden="true"></div>
        <div class="result-stage__plaque">
          <p class="result-stage__name" data-result-name>{defaultCraft.name}</p>
          <p class="micro" data-result-plaque>{defaultCraft.tempLabel} · {defaultCraft.atmosphere} · 数字器物</p>
        </div>
        <span class="result-stage__side vertical-text" aria-hidden="true">成品 · Vessel</span>
      </section>

      <aside class="record">
        <div class="record-card">
          <div class="record-card__head">
            <div>
              <p class="micro">器物档案 · Vessel record</p>
              <h2 class="record-card__title">一器一档</h2>
            </div>
            <span class="record-card__seal seal" aria-hidden="true">瓷</span>
          </div>

          <p class="record-card__intro">
            由你的轮廓、釉色与这一窑的火共同生成。它不是复制品，而是这一次制器的记录。
          </p>

          <dl class="museum-label record-card__label">
            <div class="museum-label__row"><dt>器型</dt><dd data-result-field="shape">梅瓶</dd></div>
            <div class="museum-label__row"><dt>釉色</dt><dd data-result-field="glaze">{defaultCraft.name} · {defaultCraft.subtitle}</dd></div>
            <div class="museum-label__row"><dt>窑温</dt><dd data-result-field="temp">{defaultCraft.tempLabel} · {defaultCraft.atmosphere}</dd></div>
            <div class="museum-label__row"><dt>工序</dt><dd>取土 → 拉坯 → 择釉 → 入窑 → 开窑</dd></div>
            <div class="museum-label__row"><dt>时间</dt><dd class="latin">{dateLabel}</dd></div>
            <div class="museum-label__row"><dt>编号</dt><dd class="latin" data-result-field="serial">CY-2026-0001</dd></div>
          </dl>

          <p class="record-card__no latin">NO. CY-2026-0001 · DIGITAL CERAMIC</p>
        </div>

        <div class="record-actions">
          <button class="btn btn--solid btn--block" type="button" data-result-download>
            保存器物卡 <span class="arrow" aria-hidden="true">↓</span>
          </button>
          <button class="btn btn--ghost btn--block" type="button" data-result-share>
            复制分享链接
          </button>
          <div class="record-actions__links">
            <a class="text-link" href="/create/clay">再作一件 <span class="arrow" aria-hidden="true">↺</span></a>
            <a class="text-link" href="/#process">回看五道工序 <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <p class="record-actions__note">分享链接会带上器型与釉色。器物卡为本地生成，不会上传。</p>
        </div>
      </aside>
    </div>

    <section class="memory" data-memory aria-labelledby="memory-title">
      <header class="memory__head">
        <div>
          <p class="eyebrow reveal">游器手札 · Journey memo</p>
          <h2 class="h2 reveal" id="memory-title" style="--delay: 80ms">五印落定，<br />此行有记。</h2>
        </div>
        <p class="memory__lede reveal" style="--delay: 140ms">
          这不是成绩单。它记下你在泥前停了几次、把肩线推高了几分、在哪一刻投了柴。
          五道工序走完，这一页就只属于这一次游器。
        </p>
      </header>

      <div class="memory__sheet">
        <div class="memory__top">
          <span class="memory__seal seal" aria-hidden="true">见</span>
          <div class="memory__persona">
            <p class="micro">本次游器 · 评语</p>
            <p class="memory__persona-name" data-memory-persona>梅瓶 · 初游人</p>
            <p class="memory__persona-note" data-memory-persona-note>
              五道工序还未走完，器物仍留着下一次的手温。
            </p>
          </div>
          <div class="memory__stamp">
            <p class="micro">游印</p>
            <p class="latin"><span data-memory-count>0</span> / 5</p>
          </div>
        </div>

        <ol class="memory-route" data-memory-route>
          {JOURNEY_STAGES.map((stage) => (
            <li class="memory-stop" data-memory-stage={stage.id}>
              <span class="memory-stop__line" aria-hidden="true"></span>
              <span class="memory-stop__mark" aria-hidden="true">{stage.stamp}</span>
              <span class="memory-stop__name">{stage.name}</span>
              <span class="memory-stop__quest">{stage.quest}</span>
              <span class="memory-stop__score" data-memory-stage-score>未落印</span>
              <span class="memory-stop__note" data-memory-stage-note>{stage.hint}</span>
            </li>
          ))}
        </ol>

        <div class="memory__body">
          <div class="memory__story">
            <p class="micro">这一路的注脚</p>
            <ul data-memory-narrative>
              <li>你还没有留下足够的注脚，下一次可以走慢一点。</li>
            </ul>
          </div>
          <dl class="memory__facts">
            <div><dt>器型</dt><dd data-memory-shape>梅瓶</dd></div>
            <div><dt>釉色</dt><dd data-memory-craft>青花钴蓝</dd></div>
            <div><dt>游历时长</dt><dd data-memory-duration>—</dd></div>
            <div><dt>手感均分</dt><dd data-memory-score>—</dd></div>
            <div><dt>今次日期</dt><dd data-memory-date>{dateLabel}</dd></div>
            <div><dt>手札编号</dt><dd class="latin" data-memory-id>—</dd></div>
          </dl>
        </div>

        <div class="memory__foot">
          <span>CIYUN SHUYI · FIELD NOTES</span>
          <span data-memory-signature>器成于手，亦成于火。</span>
        </div>
      </div>

      <div class="memory__actions">
        <button class="btn btn--solid" type="button" data-memory-download>
          保存游器回忆卡 <span class="arrow" aria-hidden="true">↓</span>
        </button>
        <button class="btn btn--ghost" type="button" data-memory-regenerate>
          重新生成手札 <span class="arrow" aria-hidden="true">↺</span>
        </button>
        <a class="text-link" href="/create/clay" data-journey-restart>
          再游一次 <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <nav class="result-process" aria-label="工序回看">
      {steps.map((step) => (
        <a class:list={[{'is-current': step.n === 5}]} href={step.href}>
          <span class="result-process__num latin">0{step.n}</span>
          <span class="result-process__name">{step.name}</span>
          <span class="result-process__state">{step.n < 5 ? '已完成' : '当前'}</span>
        </a>
      ))}
    </nav>

    <div class="result-quote">
      <p class="micro">After the kiln</p>
      <p class="result-quote__text">器成于手，<br />亦成于火。</p>
      <span class="seal seal--outline" aria-hidden="true">瓷</span>
    </div>
  </div>

  <script>
    import '../../scripts/result-static';
  </script>
</CreateLayout>

<style>
  .result-page {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: clamp(38px, 5.5vh, 70px) var(--gutter) clamp(80px, 11vh, 140px);
  }

  .result-head {
    padding-bottom: clamp(28px, 4.4vh, 50px);
    border-bottom: 1px solid var(--hairline);
  }

  .result-head__row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.62fr);
    align-items: end;
    gap: clamp(26px, 5vw, 90px);
  }

  .result-head__title {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 4.8vw, 5rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: 0.02em;
  }

  .result-head__note {
    max-width: 34ch;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .result-main {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(330px, 0.94fr);
    gap: clamp(28px, 4.5vw, 68px);
    align-items: start;
    padding-top: clamp(28px, 4vh, 48px);
  }

  .result-stage {
    position: relative;
    height: calc(100svh - var(--nav-h) - var(--rail-h) - 100px);
    min-height: 560px;
    max-height: 800px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background:
      radial-gradient(ellipse at 50% 40%, #fbf8f1 0%, #f0e9dc 58%, #e6dccb 100%);
    isolation: isolate;
  }

  .result-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 35%, rgba(255, 255, 255, 0.52) 0%, transparent 58%);
  }

  .result-stage__tag {
    position: absolute;
    top: 22px;
    left: 24px;
    z-index: 3;
    color: var(--text-faint);
  }

  .result-stage__arch {
    position: absolute;
    top: 8%;
    bottom: 13%;
    left: 50%;
    width: 58%;
    transform: translateX(-50%);
    border-radius: 48% 48% 0 0 / 34% 34% 0 0;
    background: linear-gradient(180deg, #f7f2e8 0%, #ece3d4 72%, #e5d8c5 100%);
    box-shadow:
      inset 0 0 70px rgba(82, 61, 38, 0.07),
      0 28px 60px rgba(70, 52, 32, 0.06);
  }

  .result-stage__arch::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(27, 24, 19, 0.06);
    border-radius: 48% 48% 0 0 / 34% 34% 0 0;
  }

  .result-stage__vessel {
    position: absolute;
    inset: 10% 16% 16%;
    display: grid;
    place-items: center;
  }

  .result-stage__vessel :global(.vessel-poster) {
    position: absolute;
    inset: 0;
  }

  .result-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .result-stage__plinth {
    position: absolute;
    right: 22%;
    bottom: 15.5%;
    left: 22%;
    height: 1px;
    background: var(--hairline);
  }

  .result-stage__plinth::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40%;
    height: 26px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(63, 45, 28, 0.17), transparent 70%);
    filter: blur(8px);
  }

  .result-stage__plaque {
    position: absolute;
    bottom: 22px;
    left: 50%;
    z-index: 3;
    min-width: 190px;
    padding: 10px 20px;
    transform: translateX(-50%);
    text-align: center;
    background: rgba(250, 246, 238, 0.82);
    border: 1px solid var(--hairline);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .result-stage__name {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .result-stage__plaque .micro {
    margin-top: 2px;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .result-stage__side {
    position: absolute;
    top: 15%;
    right: 18px;
    z-index: 3;
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    color: var(--text-faint);
    opacity: 0.7;
  }

  .record {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .record-card {
    position: relative;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--hairline);
    background: var(--paper-light);
  }

  .record-card::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid var(--hairline-soft);
    pointer-events: none;
  }

  .record-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .record-card__title {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.5vw, 2.2rem);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .record-card__seal {
    transform: rotate(3deg);
    opacity: 0.82;
  }

  .record-card__intro {
    max-width: 37ch;
    margin-top: 20px;
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--text-soft);
  }

  .record-card__label {
    margin-top: 24px;
  }

  .record-card__no {
    margin-top: 18px;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .record-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 2px;
  }

  .record-actions__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
    margin-top: 6px;
  }

  .record-actions__note {
    margin-top: 2px;
    font-size: var(--text-xs);
    line-height: 1.8;
    color: var(--text-faint);
  }

  .memory {
    margin-top: clamp(70px, 10vh, 124px);
    padding-top: clamp(34px, 5vh, 58px);
    border-top: 1px solid var(--hairline);
  }

  .memory__head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.62fr);
    align-items: end;
    gap: clamp(26px, 5vw, 90px);
  }

  .memory__head .h2 {
    margin-top: 18px;
  }

  .memory__lede {
    max-width: 36ch;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .memory__sheet {
    position: relative;
    margin-top: clamp(28px, 4.5vh, 48px);
    padding: clamp(24px, 3.4vw, 44px);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background:
      linear-gradient(90deg, transparent 0 56px, rgba(184, 97, 58, 0.12) 56px 57px, transparent 57px),
      repeating-linear-gradient(0deg, transparent 0 36px, rgba(27, 24, 19, 0.028) 36px 37px),
      var(--paper-light);
    box-shadow: 0 28px 60px rgba(60, 43, 27, 0.05);
  }

  .memory__sheet::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid var(--hairline-soft);
    pointer-events: none;
  }

  .memory__top {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(16px, 2.4vw, 30px);
    padding-left: clamp(20px, 3.8vw, 54px);
  }

  .memory__seal {
    margin-top: 3px;
    transform: rotate(-3deg);
  }

  .memory__persona-name {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.7vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: 0.05em;
  }

  .memory__persona-note {
    max-width: 40ch;
    margin-top: 8px;
    font-size: var(--text-sm);
    line-height: 1.85;
    color: var(--text-soft);
  }

  .memory__stamp {
    padding-left: 20px;
    text-align: right;
    border-left: 1px solid var(--hairline);
  }

  .memory__stamp .latin {
    margin-top: 7px;
    font-size: 1.15rem;
    color: var(--kiln);
    letter-spacing: 0.04em;
  }

  .memory-route {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 1.3vw, 22px);
    margin-top: clamp(30px, 4vh, 44px);
    padding-top: 23px;
    padding-left: clamp(20px, 3.8vw, 54px);
  }

  .memory-route::before {
    content: '';
    position: absolute;
    top: 9px;
    right: 2%;
    left: calc(clamp(20px, 3.8vw, 54px) + 7px);
    border-top: 1px dashed var(--hairline);
  }

  .memory-stop {
    position: relative;
    display: grid;
    align-content: start;
    gap: 4px;
    min-width: 0;
  }

  .memory-stop__mark {
    position: absolute;
    top: -23px;
    left: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border: 1px dashed var(--hairline);
    border-radius: 50%;
    background: var(--paper-light);
    color: var(--text-faint);
    font-family: var(--font-serif);
    font-size: 0.62rem;
    transition:
      border-color var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .memory-stop.is-filled .memory-stop__mark {
    border: 1px solid var(--kiln);
    background: color-mix(in srgb, var(--kiln) 8%, var(--paper-light));
    color: var(--kiln);
  }

  .memory-stop__name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .memory-stop__quest {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--text-soft);
  }

  .memory-stop__score {
    margin-top: 5px;
    font-family: var(--font-latin);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .memory-stop.is-filled .memory-stop__score {
    color: var(--kiln);
  }

  .memory-stop__note {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.63rem;
    line-height: 1.7;
    color: var(--text-faint);
  }

  .memory__body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(250px, 0.6fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(28px, 4vh, 44px);
    padding-left: clamp(20px, 3.8vw, 54px);
  }

  .memory__story .micro {
    margin-bottom: 12px;
  }

  .memory__story ul {
    display: grid;
    gap: 8px;
    border-left: 1px solid var(--celadon);
    padding-left: 16px;
  }

  .memory__story li {
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--text-soft);
  }

  .memory__story li::before {
    content: '—';
    margin-right: 8px;
    color: var(--text-faint);
  }

  .memory__facts {
    display: grid;
    align-content: start;
    border-top: 1px solid var(--hairline);
  }

  .memory__facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 8px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .memory__facts dt {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .memory__facts dd {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--text-soft);
    text-align: right;
  }

  .memory__foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(30px, 4vh, 44px);
    padding-top: 12px;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-latin);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .memory__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 20px;
  }

  .memory__actions .btn {
    min-height: 46px;
  }

  .memory__actions .text-link {
    margin-top: 0;
  }

  .memory.is-generating .memory__sheet {
    opacity: 0.55;
    transition: opacity var(--dur-1) var(--ease);
  }

  .result-process {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(50px, 7vh, 86px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .result-process a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 18px;
    border-right: 1px solid var(--hairline-soft);
    transition: background-color var(--dur-2) var(--ease);
  }

  .result-process a:last-child {
    border-right: 0;
  }

  .result-process a:hover {
    background: var(--accent-soft);
  }

  .result-process a.is-current {
