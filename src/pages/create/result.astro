---
import CreateLayout from '../../layouts/CreateLayout.astro';
import VesselPoster from '../../components/VesselPoster.astro';
import { defaultCraft } from '../../data/crafts';
import { steps } from '../../data/site';

const now = new Date();
const dateLabel = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;
---

<CreateLayout
  step={5}
  page="result"
  title="开窑 · 成品"
  description="第五道工序：窑门打开，器物落定。查看你的器物档案，保存或分享这只由你完成的瓷器。"
  showFooter={true}
>
  <div class="result-page">
    <header class="result-head">
      <p class="eyebrow">第五道 · 开窑 <span class="latin">/ Reveal</span></p>
      <div class="result-head__row">
        <h1 class="result-head__title">器成，<br />见你。</h1>
        <p class="result-head__note">
          窑门打开，釉色落定。这只器物由你的轮廓、所选的釉色与这一窑的火共同完成。
        </p>
      </div>
    </header>

    <div class="result-main">
      <section class="result-stage" data-result-stage aria-label="成品陈列">
        <span class="result-stage__tag micro">开窑 · 成品</span>
        <div class="result-stage__arch" aria-hidden="true"></div>
        <div class="result-stage__vessel">
          <VesselPoster tone={defaultCraft.tone} label="你完成的青花瓷瓶" />
          <div class="result-canvas" data-result-canvas aria-hidden="true"></div>
        </div>
        <div class="result-stage__plinth" aria-hidden="true"></div>
        <div class="result-stage__plaque">
          <p class="result-stage__name" data-result-name>{defaultCraft.name}</p>
          <p class="micro" data-result-plaque>{defaultCraft.tempLabel} · {defaultCraft.atmosphere} · 数字器物</p>
        </div>
        <span class="result-stage__side vertical-text" aria-hidden="true">成品 · Vessel</span>
      </section>

      <aside class="record">
        <div class="record-card">
          <div class="record-card__head">
            <div>
              <p class="micro">器物档案 · Vessel record</p>
              <h2 class="record-card__title">一器一档</h2>
            </div>
            <span class="record-card__seal seal" aria-hidden="true">瓷</span>
          </div>

          <p class="record-card__intro">
            由你的轮廓、釉色与这一窑的火共同生成。它不是复制品，而是这一次制器的记录。
          </p>

          <dl class="museum-label record-card__label">
            <div class="museum-label__row"><dt>器型</dt><dd data-result-field="shape">梅瓶</dd></div>
            <div class="museum-label__row"><dt>釉色</dt><dd data-result-field="glaze">{defaultCraft.name} · {defaultCraft.subtitle}</dd></div>
            <div class="museum-label__row"><dt>窑温</dt><dd data-result-field="temp">{defaultCraft.tempLabel} · {defaultCraft.atmosphere}</dd></div>
            <div class="museum-label__row"><dt>工序</dt><dd>取土 → 拉坯 → 择釉 → 入窑 → 开窑</dd></div>
            <div class="museum-label__row"><dt>时间</dt><dd class="latin">{dateLabel}</dd></div>
            <div class="museum-label__row"><dt>编号</dt><dd class="latin" data-result-field="serial">CY-2026-0001</dd></div>
          </dl>

          <p class="record-card__no latin">NO. CY-2026-0001 · DIGITAL CERAMIC</p>
        </div>

        <div class="record-actions">
          <button class="btn btn--solid btn--block" type="button" data-result-download>
            保存器物卡 <span class="arrow" aria-hidden="true">↓</span>
          </button>
          <button class="btn btn--ghost btn--block" type="button" data-result-share>
            复制分享链接
          </button>
          <div class="record-actions__links">
            <a class="text-link" href="/create/clay">再作一件 <span class="arrow" aria-hidden="true">↺</span></a>
            <a class="text-link" href="/#process">回看五道工序 <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <p class="record-actions__note">分享链接会带上器型与釉色。器物卡为本地生成，不会上传。</p>
        </div>
      </aside>
    </div>

    <nav class="result-process" aria-label="工序回看">
      {steps.map((step) => (
        <a class:list={[{'is-current': step.n === 5}]} href={step.href}>
          <span class="result-process__num latin">0{step.n}</span>
          <span class="result-process__name">{step.name}</span>
          <span class="result-process__state">{step.n < 5 ? '已完成' : '当前'}</span>
        </a>
      ))}
    </nav>

    <div class="result-quote">
      <p class="micro">After the kiln</p>
      <p class="result-quote__text">器成于手，<br />亦成于火。</p>
      <span class="seal seal--outline" aria-hidden="true">瓷</span>
    </div>
  </div>

  <script>
    import '../../scripts/result-static';
  </script>
</CreateLayout>

<style>
  .result-page {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: clamp(38px, 5.5vh, 70px) var(--gutter) clamp(80px, 11vh, 140px);
  }

  .result-head {
    padding-bottom: clamp(28px, 4.4vh, 50px);
    border-bottom: 1px solid var(--hairline);
  }

  .result-head__row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.62fr);
    align-items: end;
    gap: clamp(26px, 5vw, 90px);
  }

  .result-head__title {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 4.8vw, 5rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: 0.02em;
  }

  .result-head__note {
    max-width: 34ch;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .result-main {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(330px, 0.94fr);
    gap: clamp(28px, 4.5vw, 68px);
    align-items: start;
    padding-top: clamp(28px, 4vh, 48px);
  }

  .result-stage {
    position: relative;
    height: calc(100svh - var(--nav-h) - var(--rail-h) - 100px);
    min-height: 560px;
    max-height: 800px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background:
      radial-gradient(ellipse at 50% 40%, #fbf8f1 0%, #f0e9dc 58%, #e6dccb 100%);
    isolation: isolate;
  }

  .result-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 35%, rgba(255, 255, 255, 0.52) 0%, transparent 58%);
  }

  .result-stage__tag {
    position: absolute;
    top: 22px;
    left: 24px;
    z-index: 3;
    color: var(--text-faint);
  }

  .result-stage__arch {
    position: absolute;
    top: 8%;
    bottom: 13%;
    left: 50%;
    width: 58%;
    transform: translateX(-50%);
    border-radius: 48% 48% 0 0 / 34% 34% 0 0;
    background: linear-gradient(180deg, #f7f2e8 0%, #ece3d4 72%, #e5d8c5 100%);
    box-shadow:
      inset 0 0 70px rgba(82, 61, 38, 0.07),
      0 28px 60px rgba(70, 52, 32, 0.06);
  }

  .result-stage__arch::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(27, 24, 19, 0.06);
    border-radius: 48% 48% 0 0 / 34% 34% 0 0;
  }

  .result-stage__vessel {
    position: absolute;
    inset: 10% 16% 16%;
    display: grid;
    place-items: center;
  }

  .result-stage__vessel :global(.vessel-poster) {
    position: absolute;
    inset: 0;
  }

  .result-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .result-stage__plinth {
    position: absolute;
    right: 22%;
    bottom: 15.5%;
    left: 22%;
    height: 1px;
    background: var(--hairline);
  }

  .result-stage__plinth::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40%;
    height: 26px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(63, 45, 28, 0.17), transparent 70%);
    filter: blur(8px);
  }

  .result-stage__plaque {
    position: absolute;
    bottom: 22px;
    left: 50%;
    z-index: 3;
    min-width: 190px;
    padding: 10px 20px;
    transform: translateX(-50%);
    text-align: center;
    background: rgba(250, 246, 238, 0.82);
    border: 1px solid var(--hairline);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .result-stage__name {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.06em;
  }

  .result-stage__plaque .micro {
    margin-top: 2px;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .result-stage__side {
    position: absolute;
    top: 15%;
    right: 18px;
    z-index: 3;
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    color: var(--text-faint);
    opacity: 0.7;
  }

  .record {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .record-card {
    position: relative;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--hairline);
    background: var(--paper-light);
  }

  .record-card::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid var(--hairline-soft);
    pointer-events: none;
  }

  .record-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .record-card__title {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.5vw, 2.2rem);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .record-card__seal {
    transform: rotate(3deg);
    opacity: 0.82;
  }

  .record-card__intro {
    max-width: 37ch;
    margin-top: 20px;
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--text-soft);
  }

  .record-card__label {
    margin-top: 24px;
  }

  .record-card__no {
    margin-top: 18px;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .record-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 2px;
  }

  .record-actions__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
    margin-top: 6px;
  }

  .record-actions__note {
    margin-top: 2px;
    font-size: var(--text-xs);
    line-height: 1.8;
    color: var(--text-faint);
  }

  .result-process {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(50px, 7vh, 86px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .result-process a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 18px;
    border-right: 1px solid var(--hairline-soft);
    transition: background-color var(--dur-2) var(--ease);
  }

  .result-process a:last-child {
    border-right: 0;
  }

  .result-process a:hover {
    background: var(--accent-soft);
  }

  .result-process a.is-current {
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }

  .result-process__num {
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  .result-process__name {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    letter-spacing: 0.06em;
  }

  .result-process__state {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .result-process a.is-current .result-process__state {
    color: var(--accent);
  }

  .result-quote {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding-top: clamp(70px, 10vh, 120px);
    text-align: center;
  }

  .result-quote__text {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: var(--text-soft);
  }

  .result-quote .seal {
    margin-top: 8px;
    opacity: 0.55;
  }

  @media (max-width: 1080px) {
    .result-main {
      grid-template-columns: minmax(0, 1fr);
    }

    .result-stage {
      height: min(62svh, 620px);
      min-height: 440px;
    }

    .result-stage__vessel {
      inset: 9% 20% 15%;
    }

    .record {
      gap: 24px;
    }

    .record-actions {
      max-width: 480px;
    }
  }

  @media (max-width: 760px) {
    .result-head__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .result-head__title {
      font-size: clamp(2.4rem, 9vw, 3.4rem);
    }

    .result-stage {
      height: min(56svh, 520px);
      min-height: 380px;
    }

    .result-stage__vessel {
      inset: 8% 14% 16%;
    }

    .result-stage__side {
      display: none;
    }

    .result-process {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .result-process::-webkit-scrollbar {
      display: none;
    }

    .result-process a {
      min-width: 116px;
      flex: 1 0 auto;
    }

    .record-card {
      padding: 24px 20px;
    }
  }

  @media (max-width: 440px) {
    .result-stage__arch {
      width: 72%;
    }

    .result-stage__vessel {
      inset: 8% 10% 16%;
    }

    .record-card__seal {
      display: none;
    }
  }
</style>
