---
import CreateLayout from '../../layouts/CreateLayout.astro';
import VesselPoster from '../../components/VesselPoster.astro';
import CraftCard from '../../components/CraftCard.astro';
import ReferencePlate from '../../components/ReferencePlate.astro';
import { crafts, defaultCraft } from '../../data/crafts';
import { referenceById } from '../../data/references';

const referenceNotes: Record<string, string> = {
  longquan: '龙泉窑青釉瓶的淡青与金缮，是「温润」最好的注脚。',
  qinghua: '梅瓶上的钴蓝人物纹，是青花与器型相遇的样子。',
  jian: '兔毫盏的黑釉里，火痕细如兔毛。',
  jun: '天蓝釉上的紫斑，来自铜红在还原焰中的偶然。',
};
---

<CreateLayout
  step={3}
  page="craft"
  title="择釉 · 选择釉色"
  description="第三道工序：为你的器型选择一种釉色与烧成方式。龙泉青瓷、青花、建盏、钧窑，各有各的火候。"
  showFooter={true}
>
  <div class="craft-page">
    <header class="craft-head">
      <div>
        <p class="eyebrow">第三道 · 择釉 <span class="latin">/ Glaze</span></p>
        <h1 class="craft-head__title">火之前，<br />先择一身釉色。</h1>
      </div>
      <p class="craft-head__note">
        四种釉色，四种火候。青、蓝、黑、紫，没有哪一种更好，只有哪一种更像你。
      </p>
    </header>

    <section class="glaze-trial" data-glaze-trial aria-labelledby="glaze-trial-title">
      <div class="glaze-trial__intro">
        <span class="glaze-trial__seal" aria-hidden="true">辨</span>
        <p class="micro">试炼 · 试釉三问</p>
        <h2 class="glaze-trial__title" id="glaze-trial-title">先听釉色，<br />再选火。</h2>
        <p class="glaze-trial__copy">
          每一句釉色的话，都藏着它走过的那把火。答对三问，落一枚「辨」印。
        </p>
        <p class="glaze-trial__count">
          第 <span data-glaze-round>01</span> 问 <span class="faint">/ 03</span>
        </p>
        <button class="glaze-trial__skip" type="button" data-glaze-skip>
          直接择釉 <span class="arrow" aria-hidden="true">↓</span>
        </button>
      </div>

      <div class="glaze-trial__board">
        <p class="glaze-trial__clue" data-glaze-clue>“白地青花，一笔一世界。”</p>
        <p class="glaze-trial__ask">这句话说的是哪一种釉？</p>
        <div class="glaze-trial__options" data-glaze-options>
          {crafts.map((craft) => (
            <button class="glaze-choice" type="button" data-glaze-option={craft.id}>
              <span class="glaze-choice__swatch" style={`--swatch: ${craft.swatch};`} aria-hidden="true"></span>
              <span>{craft.name}</span>
              <span class="glaze-choice__mark" aria-hidden="true">
                <span></span><span></span>
              </span>
            </button>
          ))}
        </div>
        <p class="glaze-trial__feedback" data-glaze-feedback role="status" aria-live="polite">
          选一个釉色，看看火怎么说。
        </p>
      </div>

      <div class="glaze-trial__done" data-glaze-done hidden>
        <p class="micro">辨印 · Glaze seal</p>
        <p class="glaze-trial__done-title">三问已过，<br />釉色认得了。</p>
        <p class="glaze-trial__done-score" data-glaze-score>辨釉 · 100</p>
        <p class="glaze-trial__done-copy">现在，凭你真正喜欢的那一抹颜色，往下选。</p>
      </div>
    </section>

    <div class="craft-main">
      <section
        class="craft-stage"
        data-craft-stage
        style={`--craft-accent: ${defaultCraft.glaze.accent};`}
        aria-label="釉色预览"
      >
        <div class="craft-stage__meta">
          <span><span class="status-dot" aria-hidden="true"></span> 实时预览</span>
          <span class="micro">釉层 · 单层</span>
        </div>

        <span class="craft-stage__side vertical-text" aria-hidden="true">釉色 · Glaze</span>

        <div class="craft-stage__vessel">
          <VesselPoster
            tone={defaultCraft.tone}
            label="一只正在预览釉色的瓷瓶"
          />
          <div class="craft-canvas" data-craft-canvas aria-hidden="true"></div>
        </div>

        <div class="craft-stage__plinth" aria-hidden="true"></div>

        <div class="craft-stage__caption">
          <div>
            <p class="micro">已选 · Selected</p>
            <p class="craft-stage__name" data-craft-name>{defaultCraft.name}</p>
          </div>
          <div class="craft-stage__temp">
            <span class="craft-stage__dot" data-craft-dot aria-hidden="true"></span>
            <span data-craft-temp>{defaultCraft.tempLabel} · {defaultCraft.atmosphere}</span>
          </div>
        </div>
      </section>

      <div class="craft-panel">
        <div class="craft-grid" role="radiogroup" aria-label="选择釉色">
          {crafts.map((craft) => (
            <CraftCard
              craft={craft}
              selected={craft.id === defaultCraft.id}
              variant="row"
            />
          ))}
        </div>

        <div class="craft-details">
          {crafts.map((craft) => (
            <article class="craft-detail" data-craft-detail={craft.id} hidden={craft.id !== defaultCraft.id}>
              <div class="craft-detail__head">
                <p class="eyebrow">{craft.subtitle} · {craft.character}</p>
                <h2 class="h3">{craft.name}</h2>
                <p class="craft-detail__note">{craft.note}</p>
              </div>

              <dl class="museum-label craft-detail__label">
                <div class="museum-label__row"><dt>釉色</dt><dd>{craft.subtitle}</dd></div>
                <div class="museum-label__row"><dt>窑温</dt><dd>{craft.tempLabel}</dd></div>
                <div class="museum-label__row"><dt>气氛</dt><dd>{craft.atmosphere}</dd></div>
                <div class="museum-label__row"><dt>发色</dt><dd>{craft.character}</dd></div>
              </dl>

              <div class="craft-reference">
                <ReferencePlate reference={referenceById[craft.referenceId]} reveal={false} />
                <div class="craft-reference__note">
                  <p class="micro">馆藏参照 · Reference</p>
                  <p>{referenceNotes[craft.id]}</p>
                  <p class="faint">图像与藏品信息来自 The Metropolitan Museum of Art 开放获取计划（CC0）。</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="craft-actions">
          <div class="craft-actions__main">
            <a class="btn btn--solid" href="/create/fire">
              封窑，入火 <span class="arrow" aria-hidden="true">→</span>
            </a>
            <a class="text-link" href="/create/form">返回拉坯 <span class="arrow" aria-hidden="true">←</span></a>
          </div>
          <p class="craft-actions__note">
            选择会带到入窑与成品。釉色为数字模拟，真实的窑变总会多给一点意外。
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/craft-static';
    import '../../scripts/glaze-trial';
  </script>
</CreateLayout>

<style>
  .craft-page {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: clamp(34px, 5vh, 62px) var(--gutter) clamp(70px, 10vh, 120px);
  }

  .craft-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
    align-items: end;
    gap: clamp(28px, 5vw, 90px);
    padding-bottom: clamp(30px, 4.5vh, 54px);
    border-bottom: 1px solid var(--hairline);
  }

  .craft-head__title {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 4.2vw, 4.3rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: 0.02em;
  }

  .craft-head__note {
    max-width: 34ch;
    color: var(--text-soft);
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .craft-main {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: clamp(28px, 4.5vw, 70px);
    align-items: start;
    padding-top: clamp(28px, 4vh, 48px);
  }

  .craft-stage {
    position: sticky;
    top: calc(var(--nav-h) + var(--rail-h) + 18px);
    height: calc(100svh - var(--nav-h) - var(--rail-h) - 36px);
    min-height: 520px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background:
      radial-gradient(ellipse at 50% 38%, #fbf7ef 0%, #f1e9dc 52%, #e6dac8 100%);
    isolation: isolate;
  }

  .craft-stage::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in srgb, var(--craft-accent) 18%, transparent) 0%,
      transparent 62%
    );
    transition: background 0.8s var(--ease);
  }

  .craft-stage__meta {
    position: absolute;
    top: 20px;
    right: 24px;
    left: 24px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }

  .craft-stage__meta > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .craft-stage__side {
    position: absolute;
    top: 16%;
    right: 18px;
    z-index: 2;
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    color: var(--text-faint);
    opacity: 0.7;
  }

  .craft-stage__vessel {
    position: absolute;
    inset: 9% 12% 18%;
    display: grid;
    place-items: center;
  }

  .craft-stage__vessel :global(.vessel-poster) {
    position: absolute;
    inset: 0;
  }

  .craft-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .craft-stage__plinth {
    position: absolute;
    right: 16%;
    bottom: 16.5%;
    left: 16%;
    height: 1px;
    background: var(--hairline);
  }

  .craft-stage__plinth::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 38%;
    height: 24px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(63, 45, 28, 0.16), transparent 70%);
    filter: blur(8px);
  }

  .craft-stage__caption {
    position: absolute;
    right: 24px;
    bottom: 22px;
    left: 24px;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--hairline);
  }

  .craft-stage__name {
    margin-top: 3px;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    letter-spacing: 0.05em;
  }

  .craft-stage__temp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-latin);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  .craft-stage__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--craft-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--craft-accent) 16%, transparent);
    transition: background-color var(--dur-2) var(--ease);
  }

  .craft-panel {
    display: flex;
    flex-direction: column;
    gap: clamp(26px, 3.5vh, 40px);
  }

  .craft-panel .craft-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .craft-detail {
    padding-top: 4px;
  }

  .craft-detail__note {
    margin-top: 14px;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .craft-detail__label {
    margin-top: 22px;
  }

  .craft-reference {
    display: grid;
    grid-template-columns: minmax(0, 0.74fr) minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 30px);
    margin-top: 28px;
    align-items: start;
  }

  .craft-reference :global(.ref-plate) {
    min-width: 0;
  }

  .craft-reference__note {
    display: grid;
    gap: 12px;
    padding-top: 4px;
    font-size: var(--text-sm);
    line-height: 1.9;
    color: var(--text-soft);
  }

  .craft-reference__note .faint {
    font-size: var(--text-xs);
    line-height: 1.8;
  }

  .craft-actions {
    padding-top: clamp(26px, 3.5vh, 40px);
    border-top: 1px solid var(--hairline);
  }

  .craft-actions__main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .craft-actions__note {
    margin-top: 16px;
    max-width: 38ch;
    font-size: var(--text-xs);
    line-height: 1.8;
    color: var(--text-faint);
  }

  .glaze-trial {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(28px, 5vw, 76px);
    margin-top: clamp(26px, 4vh, 44px);
    padding: clamp(22px, 3vw, 34px);
    overflow: hidden;
    background:
      radial-gradient(circle at 84% 20%, rgba(226, 118, 67, 0.08), transparent 44%),
      var(--ink);
    color: var(--night-ink);
    isolation: isolate;
  }

  .glaze-trial::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: -1;
    border: 1px solid rgba(232, 217, 197, 0.08);
    pointer-events: none;
  }

  .glaze-trial::after {
    content: '釉';
    position: absolute;
    right: 3%;
    bottom: -0.24em;
    z-index: -1;
    font-family: var(--font-serif);
    font-size: clamp(8rem, 15vw, 15rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(232, 217, 197, 0.055);
    pointer-events: none;
  }

  .glaze-trial__intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .glaze-trial .micro {
    color: rgba(232, 217, 197, 0.48);
  }

  .glaze-trial__seal {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 16px;
    border: 1px solid rgba(232, 217, 197, 0.22);
    color: var(--kiln-bright);
    font-family: var(--font-serif);
    font-size: 0.86rem;
  }

  .glaze-trial__title {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.1vw, 2.1rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.03em;
  }

  .glaze-trial__copy {
    max-width: 30ch;
    margin-top: 14px;
    font-size: 0.74rem;
    line-height: 1.8;
    color: rgba(232, 217, 197, 0.56);
  }

  .glaze-trial__count {
    margin-top: 20px;
    font-family: var(--font-latin);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: rgba(232, 217, 197, 0.56);
  }

  .glaze-trial__skip {
    margin-top: auto;
    padding-top: 20px;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(232, 217, 197, 0.46);
    transition: color var(--dur-1) var(--ease);
  }

  .glaze-trial__skip:hover {
    color: var(--night-ink);
  }

  .glaze-trial__board {
    align-self: center;
    padding-left: clamp(0px, 2vw, 30px);
    border-left: 1px solid rgba(232, 217, 197, 0.12);
  }

  .glaze-trial__clue {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.3vw, 2.15rem);
    line-height: 1.55;
    letter-spacing: 0.04em;
    color: var(--night-ink);
  }

  .glaze-trial__ask {
    margin-top: 8px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: rgba(232, 217, 197, 0.42);
  }

  .glaze-trial__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
    margin-top: 18px;
  }

  .glaze-choice {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 18px;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 7px 10px;
    border: 1px solid rgba(232, 217, 197, 0.12);
    text-align: left;
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    color: rgba(232, 217, 197, 0.72);
    transition:
      border-color var(--dur-1) var(--ease),
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  .glaze-choice:hover,
  .glaze-choice:focus-visible {
    border-color: rgba(232, 217, 197, 0.38);
    background: rgba(232, 217, 197, 0.04);
    color: var(--night-ink);
  }

  .glaze-choice__swatch {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow:
      inset -3px -4px 8px rgba(0, 0, 0, 0.3),
      inset 2px 2px 5px rgba(255, 255, 255, 0.2);
  }

  .glaze-choice__mark {
    position: relative;
    width: 14px;
    height: 14px;
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease);
  }

  .glaze-choice__mark span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
  }

  .glaze-choice__mark span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .glaze-choice__mark span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .glaze-choice.is-wrong {
    border-color: rgba(226, 118, 67, 0.52);
    color: var(--kiln-bright);
    animation: glaze-shake 360ms var(--ease);
  }

  .glaze-choice.is-wrong .glaze-choice__mark {
    opacity: 1;
  }

  .glaze-choice:disabled {
    cursor: default;
  }

  .glaze-trial.is-done .glaze-trial__skip {
    display: none;
  }

  .glaze-choice.is-correct {
    border-color: rgba(158, 197, 174, 0.52);
    background: rgba(158, 197, 174, 0.1);
    color: #d8e5da;
  }

  @keyframes glaze-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .glaze-trial__feedback {
    min-height: 1.7em;
    margin-top: 12px;
    font-size: 0.68rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: rgba(232, 217, 197, 0.42);
    transition: color var(--dur-2) var(--ease);
  }

  .glaze-trial__feedback.is-correct {
    color: #a9c4b3;
  }

  .glaze-trial__feedback.is-wrong {
    color: var(--kiln-bright);
  }

  .glaze-trial__done {
    align-self: center;
  }

  .glaze-trial__done-title {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.45;
    letter-spacing: 0.04em;
  }

  .glaze-trial__done-score {
    margin-top: 18px;
    font-family: var(--font-latin);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--kiln-bright);
  }

  .glaze-trial__done-copy {
    margin-top: 10px;
    font-size: 0.72rem;
    line-height: 1.75;
    color: rgba(232, 217, 197, 0.48);
  }

  .glaze-trial.is-done .glaze-trial__board {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .glaze-choice.is-wrong {
      animation: none;
    }
  }

  @media (max-width: 1080px) {
    .glaze-trial {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .glaze-trial__board {
      padding-top: 22px;
      padding-left: 0;
      border-top: 1px solid rgba(232, 217, 197, 0.12);
      border-left: 0;
    }

    .glaze-trial__intro {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: 14px;
    }

    .glaze-trial__seal {
      grid-row: span 4;
      margin-bottom: 0;
    }

    .glaze-trial__title {
      margin-top: 8px;
    }

    .glaze-trial__count {
      margin-top: 12px;
    }

    .glaze-trial__skip {
      grid-column: 2;
      margin-top: 8px;
      padding-top: 0;
    }

    .craft-main {
      grid-template-columns: minmax(0, 1fr);
    }

    .craft-stage {
      position: relative;
      top: auto;
      height: min(56svh, 560px);
      min-height: 420px;
    }

    .craft-stage__vessel {
      inset: 8% 20% 16%;
    }

    .craft-panel .craft-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .glaze-trial__options {
      grid-template-columns: minmax(0, 1fr);
    }

    .glaze-trial__clue {
      font-size: clamp(1.2rem, 5.4vw, 1.65rem);
    }

    .craft-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .craft-head__title {
      font-size: clamp(2.3rem, 8.4vw, 3.2rem);
    }

    .craft-stage {
